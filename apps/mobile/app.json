{
  "expo": {
    "name": "GymGO",
    "slug": "gymgo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gymgo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GymGO uses your precise location on this device to show gyms near you and how far away they are. It is never stored or sent anywhere."
        }
      ],
      "expo-secure-store",
    [
      "expo-image-picker",
      {
        "photosPermission": "GymGO opens your photos only when you choose to share a picture of a gym.",
        "cameraPermission": false,
        "microphonePermission": false
      }
    ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
