/**
 * Each bundled brand logo's own colour (assets/logos/<slug>.png, from
 * scripts/brand-logos.mjs), for that chain's collection cards
 * (components/GemCard.tsx): read from the logo's pixels by the same rule the
 * server uses on a website icon (packages/domain/src/cardColour.ts), and
 * written to src/lib/brandColours.ts. A black, white or grey logo gets no
 * colour, and its cards keep their gem's.
 *
 *   node_modules/.bin/tsx scripts/brand-colours.mts
 *
 * Run it again whenever brand-logos.mjs changes the logos.
 */

import { readdirSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import sharp from 'sharp';
import { logoColour } from '../../../packages/domain/src/cardColour';

const here = dirname(fileURLToPath(import.meta.url));
const app = join(here, '..');
const logos = join(app, 'assets', 'logos');

const lines: string[] = [];
for (const file of readdirSync(logos).filter((name) => name.endsWith('.png')).sort()) {
  const slug = file.slice(0, -4);
  // Small is plenty for a colour, and keeps every logo to the same say.
  const { data } = await sharp(join(logos, file)).resize(96, 96, { fit: 'inside' }).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
  const colour = logoColour(data, 4);
  lines.push(`  ${JSON.stringify(slug)}: ${colour ? JSON.stringify(colour) : 'null'},`);
  console.log(`${slug.padEnd(24)} ${colour ?? '(no colour: black, white or grey)'}`);
}

writeFileSync(
  join(app, 'src', 'lib', 'brandColours.ts'),
  `// Generated by scripts/brand-colours.mts from assets/logos. Do not edit by hand.
// Each logo's own colour (packages/domain/src/cardColour.ts), or null for a
// black, white or grey one.

// prettier-ignore
export const BRAND_COLOURS: Record<string, string | null> = {
${lines.join('\n')}
};
`,
);
