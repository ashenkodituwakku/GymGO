# Copy to apps/server/.env.local (git-ignored) and fill in what you use.
# Everything here is optional; without it GymGO runs, and says what's off.

# GymGO Pro through Stripe. Start with your TEST secret key (sk_test_…) from
# Stripe → Developers → API keys. Then run:
#   npx pnpm@10 --filter @gymgo/server stripe:setup
STRIPE_SECRET_KEY=

# Optional: the signing secret (whsec_…) of a webhook pointed at
# /api/billing/webhook. Locally: stripe listen --forward-to localhost:4000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=

# Optional, once the server is hosted: its public https address.
GYMGO_PUBLIC_URL=

# Optional: extra browser origins allowed to call the API (comma-separated).
GYMGO_ALLOWED_ORIGINS=

# Optional and paid: your own Google Places API key (see README).
GOOGLE_PLACES_API_KEY=

# Optional: email bug reports from the app to the team. The SMTP account to
# send through, as one address. For Gmail, make an app password (Google
# Account → Security → 2-Step Verification → App passwords) and write the
# @ in your address as %40:
#   smtps://you%40gmail.com:your-app-password@smtp.gmail.com:465
# Without it, reports are kept on this server (moderators read them in Profile).
GYMGO_SMTP_URL=
# Optional: who the emails say they're from (the SMTP account by default).
GYMGO_MAIL_FROM=
# Optional: where reports are emailed, comma-separated (the GymGO team by default).
GYMGO_BUG_REPORT_TO=

# Optional: GymGO's designated copyright (DMCA) agent, as registered with the
# US Copyright Office at dmca.copyright.gov (see README, Legal basics). The
# app shows them in Profile → Copyright and takedowns. Nothing is registered yet.
GYMGO_DMCA_AGENT_NAME=
GYMGO_DMCA_AGENT_ADDRESS=
GYMGO_DMCA_AGENT_EMAIL=

# Who runs GymGO, for the Terms of Service, Privacy Policy and the other
# legal pages (/terms, /privacy, /refunds, /community). Set these before
# GymGO is public, a contact email especially (README, Legal basics).
GYMGO_LEGAL_NAME=
GYMGO_CONTACT_EMAIL=
GYMGO_LEGAL_ADDRESS=
# Whose laws the terms are under, e.g. Victoria, Australia (Australia by default).
GYMGO_GOVERNING_LAW=
# Where the server and its backups are, e.g. Australia (optional).
GYMGO_HOSTED_IN=

# Only behind a reverse proxy such as Caddy (the hosting setup sets it):
# rate limits then use the address the proxy passes on.
GYMGO_TRUST_PROXY=

# Optional: a folder for a daily copy of the database, kept 14 days.
GYMGO_BACKUP_DIR=
