# GymGO local configuration. Copy to .env.local and adjust.
# The application runs with none of these set: every external provider has an
# honest "not configured" state rather than a fake success.

# --- Data source ----------------------------------------------------------
# "demo"  = the fictional pilot dataset in src/fixtures (default outside production)
# "none"  = serve no listings (default in production, so fixtures cannot be
#           mistaken for real venues)
GYMGO_DATA_SOURCE=demo

# --- Authentication -------------------------------------------------------
# "local-dev" = cookie session with a visible account switcher, for local work
# "disabled"  = no sign-in (default in production builds)
# Using local-dev in a production build additionally requires
# GYMGO_ALLOW_DEV_AUTH_IN_PROD=yes-i-understand and shows a permanent warning
# banner on every page.
GYMGO_AUTH_ADAPTER=local-dev
# GYMGO_ALLOW_DEV_AUTH_IN_PROD=

# --- Map provider ---------------------------------------------------------
# Unset by default. Without one of these the map area shows
# "Map tiles are not configured" and the list view remains fully usable.
# Choose a basemap licence suitable for a directory before production; see
# docs/ARCHITECTURE.md.
# NEXT_PUBLIC_MAP_STYLE_URL=
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
