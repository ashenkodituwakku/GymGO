# GymGO online: copy this file to deploy/.env and fill it in.
# It holds passwords and keys: never commit deploy/.env or send it to anyone.

# --- Where GymGO lives (needed) ---------------------------------------------
# A domain or free subdomain pointing at this server (README says how to get one).
GYMGO_DOMAIN=gymgo.example.com
GYMGO_PUBLIC_URL=https://gymgo.example.com

# --- Who runs it, for the Terms and Privacy Policy (needed before launch) -----
GYMGO_LEGAL_NAME=
GYMGO_CONTACT_EMAIL=
GYMGO_LEGAL_ADDRESS=
GYMGO_GOVERNING_LAW=
GYMGO_HOSTED_IN=

# --- Email: password reset links and bug reports -----------------------------
# smtps://you%40gmail.com:your-app-password@smtp.gmail.com:465 (README, Report a bug)
GYMGO_SMTP_URL=
GYMGO_MAIL_FROM=
GYMGO_BUG_REPORT_TO=

# --- GymGO Pro (README, GymGO Pro). Test keys until you're ready --------------
STRIPE_SECRET_KEY=
# From the webhook you add in Stripe for https://<your domain>/api/billing/webhook
STRIPE_WEBHOOK_SECRET=

# --- Optional ----------------------------------------------------------------
GYMGO_GOOGLE_CLIENT_ID_WEB=
GYMGO_GOOGLE_CLIENT_ID_IOS=
GYMGO_GOOGLE_CLIENT_ID_ANDROID=
GYMGO_APPLE_CLIENT_IDS=
GOOGLE_PLACES_API_KEY=
GYMGO_DMCA_AGENT_NAME=
GYMGO_DMCA_AGENT_ADDRESS=
GYMGO_DMCA_AGENT_EMAIL=
